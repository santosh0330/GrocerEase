{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "LogFiles": {
    "Enabled": true,
    "Directory": "logs",
    "RetainedDays": 14,
    "MaxFileSizeKilobytes": 102400
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Health": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "PlaceOrder": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "GrocerEase",
    "Audience": "GrocerEase",
    "ExpiryMinutes": 10
  },
  "RefreshToken": {
    "LifetimeDays": 3,
    "MaxLifetimeDays": 30
  }
}
