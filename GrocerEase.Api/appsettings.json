{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz "
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Health": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "GrocerEase",
    "Audience": "GrocerEase",
    "ExpiryMinutes": 60
  },
  "RefreshToken": {
    "LifetimeDays": 3,
    "MaxLifetimeDays": 30
  }
}
