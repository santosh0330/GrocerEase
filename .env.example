# Copy to .env (which git ignores) and choose real values.
POSTGRES_DB=grocerease
POSTGRES_USER=grocerease

# POSTGRES_USER is the bootstrap superuser. Nothing in the application connects as it: the API uses DB_APP_PASSWORD's
# role and migrations use DB_MIGRATOR_PASSWORD's role. All three passwords are placeholders: replace each with its own
# random value, and use hex so no character needs escaping in a connection string or in Compose:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-run-openssl-rand-hex-24
DB_MIGRATOR_PASSWORD=replace-me-run-openssl-rand-hex-24
DB_APP_PASSWORD=replace-me-run-openssl-rand-hex-24

# Signs the login tokens. Anyone who knows it can forge a token for any user, so keep it secret and make it random:
#   openssl rand -base64 48
# The value below is a placeholder on purpose: it is shorter than the 32 characters the API requires,
# so the API will not start until you replace it.
JWT_SECRET_KEY=replace-me-run-openssl-rand
