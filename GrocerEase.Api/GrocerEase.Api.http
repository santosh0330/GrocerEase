@GrocerEase.Api_HostAddress = http://localhost:8080

POST {{GrocerEase.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com",
  "password": "s3cret!!"
}

###

# The name lets the requests below reuse this response: {{login.response.body.$.token}} is the access token it returns,
# {{login.response.body.$.refreshToken}} the refresh token.
# @name login
POST {{GrocerEase.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "s3cret!!"
}

###

# Exchange the refresh token for a new pair. 200 with a new "token" and a NEW "refreshToken": the one sent is used up, so the second
# send of this request (without logging in again) is 401 "Authentication.InvalidRefreshToken", and revokes the whole session.
# @name refresh
POST {{GrocerEase.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

###

# Protected: only a signed-in user may call it. Run "login" first; the token it returns is sent as a bearer token.
# 200 with { id, firstName, lastName, email, role }.
GET {{GrocerEase.Api_HostAddress}}/me
Authorization: Bearer {{login.response.body.$.token}}

###

# The same route with no token: 401 application/problem+json, code "Authentication.Required",
# and a "WWW-Authenticate: Bearer" header.
GET {{GrocerEase.Api_HostAddress}}/me

###

# A token that is not valid (garbage, signed with another key, for another audience): 401 with code
# "Authentication.InvalidToken". An expired one gives "Authentication.TokenExpired": sign in again.
GET {{GrocerEase.Api_HostAddress}}/me
Authorization: Bearer not-a-real-token

###

# Guarded by the Admin role. A user who just registered is a Customer, so this is 403 application/problem+json with code
# "Authorization.Forbidden". After the user is made an admin (see "Roles" in the README) and logs in again, it is 200 with
# [ { "id": "...", "name": "Admin" }, { "id": "...", "name": "Customer" } ]. With no token it is 401.
GET {{GrocerEase.Api_HostAddress}}/roles
Authorization: Bearer {{login.response.body.$.token}}

###

# Stores. Anyone signed in may read them (stores.read); creating one needs stores.manage, which only an admin has, so run these as
# an admin (see "Roles and permissions" in the README). 201 with { "id", "name", "address" }; the same name twice is 409 "Store.DuplicateName".
# @name createStore
POST {{GrocerEase.Api_HostAddress}}/stores
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Fresh Mart",
  "address": "1 High Street"
}

###

GET {{GrocerEase.Api_HostAddress}}/stores
Authorization: Bearer {{login.response.body.$.token}}

###

# Assign a registered customer to the store: that makes them a store user (200). An unknown store or email is 404, an admin or someone
# who already runs a store is 409 "User.NotACustomer". Their token keeps saying Customer until they log in or refresh.
# @name assignMember
POST {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/members
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "email": "asha@example.com"
}

###

# Take them out again: 204, and they are a customer. 404 "Store.MemberNotFound" if they do not run this store.
DELETE {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/members/{{assignMember.response.body.$.userId}}
Authorization: Bearer {{login.response.body.$.token}}

###

# Products. Adding, editing and archiving need products.manage AND running the store: sign in as the store user you assigned above (log in as
# asha@example.com). Anyone signed in may browse. A store you do not run is 404 "Store.NotFound", never 403.
# @name createProduct
POST {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/products
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Milk",
  "description": "Fresh",
  "price": 2.50
}

###

# A page of the store's products: page counts from 1, pageSize is 1 to 100 (20 by default). { "items": [...], "page", "pageSize", "totalCount" }
GET {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/products?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.token}}

###

PUT {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Oat milk",
  "description": "Vegan",
  "price": 3.20
}

###

# "Deletes" the product by archiving it: 204, it leaves the catalogue, and its name is free again.
DELETE {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

###

# Stock. Same rule as products: the store user of that store. A change is an amount (positive adds, negative removes), never a new total.
# 200 { "productId", "quantityOnHand" }; removing more than there is gives 409 "Inventory.NotEnoughStock"; a change of zero is 400.
POST {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/products/{{createProduct.response.body.$.id}}/stock-adjustments
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "delta": 12
}

###

# Every product on sale in the store with how many are on hand (zero when it has never had stock), a page at a time.
GET {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/inventory?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.token}}

###

# Orders. Only a CUSTOMER orders: log in as an ordinary user, not the store user. The stock of every line is reserved at once, all or nothing:
# 201 and the order (Pending); 409 "Order.InsufficientStock" if a line cannot be filled; 404 for an unknown store, or a product that is unknown,
# archived, or another store's. A product may appear once: ask for a bigger quantity. Limited to 20 a minute.
# @name placeOrder
POST {{GrocerEase.Api_HostAddress}}/stores/{{createStore.response.body.$.id}}/orders
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "deliveryAddress": "1 High Street",
  "lines": [
    { "productId": "{{createProduct.response.body.$.id}}", "quantity": 2 }
  ]
}

###

# My own orders, newest first, a page at a time. Someone else's order is 404, exactly as one that does not exist.
GET {{GrocerEase.Api_HostAddress}}/orders?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.token}}

###

GET {{GrocerEase.Api_HostAddress}}/orders/{{placeOrder.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

###

# Health, readiness: open to anyone, no token. Runs every check, including the database.
# 200 { "status": "Healthy", "totalDurationMs": 4.1, "checks": [ { "name": "database", "status": "Healthy", "durationMs": 3.8 } ] }
# 503 with "status": "Unhealthy" when the database cannot be reached or has not been migrated. It never says why: that goes to the log.
GET {{GrocerEase.Api_HostAddress}}/health

###

# Health, liveness: runs no check, so it is 200 whenever the process answers, even if the database is down.
GET {{GrocerEase.Api_HostAddress}}/health/live

###
