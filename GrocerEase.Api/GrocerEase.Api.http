@GrocerEase.Api_HostAddress = http://localhost:8080

POST {{GrocerEase.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com",
  "password": "s3cret!!"
}

###

# The name lets the requests below reuse this response: {{login.response.body.$.token}} is the token it returns.
# @name login
POST {{GrocerEase.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "s3cret!!"
}

###

# Protected: only a signed-in user may call it. Run "login" first; the token it returns is sent as a bearer token.
# 200 with { id, firstName, lastName, email }.
GET {{GrocerEase.Api_HostAddress}}/me
Authorization: Bearer {{login.response.body.$.token}}

###

# The same route with no token: 401 application/problem+json, code "Authentication.Required",
# and a "WWW-Authenticate: Bearer" header.
GET {{GrocerEase.Api_HostAddress}}/me

###

# A token that is not valid (garbage, signed with another key, for another audience): 401 with code
# "Authentication.InvalidToken". An expired one gives "Authentication.TokenExpired": sign in again.
GET {{GrocerEase.Api_HostAddress}}/me
Authorization: Bearer not-a-real-token

###
