{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "Jwt": {
    "Issuer": "GrocerEase",
    "Audience": "GrocerEase",
    "ExpiryMinutes": 60
  }
}
