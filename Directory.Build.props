<Project>

  <!-- Imported automatically by every project under this folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Static analysis -->
  <PropertyGroup>
    <!-- Newest .NET analyzer rule set, at the "Recommended" strictness (more rules on than the default). -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <!-- Run IDExxxx code-style rules (from .editorconfig) during dotnet build, not just in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Any compiler, analyzer or NuGet warning fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Two versions of one assembly in the build (MSB3277) is only a warning to MSBuild, and TreatWarningsAsErrors does not catch it. -->
    <WarningsAsErrors>$(WarningsAsErrors);MSB3277</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version comes from Directory.Packages.props. PrivateAssets keeps the analyzer from flowing to consumers. -->
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
