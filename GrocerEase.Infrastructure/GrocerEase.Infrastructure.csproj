<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Identity, Options and the DI abstractions ship with ASP.NET Core, so no package is needed for them. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- The Npgsql provider asks for an older EF Core than the Design package does. Naming both here makes one version win,
         instead of two copies of EF Core ending up side by side (build warning MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Only the "dotnet ef" tool needs this, at design time: it must not flow to projects that reference Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrocerEase.Application\GrocerEase.Application.csproj" />
  </ItemGroup>

</Project>
